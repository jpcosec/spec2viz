{
  "integrate": {
    "remote_url": "https://github.com/jpcosec/specir.git",
    "branch": "main",
    "push_env": {
      "GIT_TERMINAL_PROMPT": "0",
      "GIT_CONFIG_COUNT": "3",
      "GIT_CONFIG_KEY_0": "credential.helper",
      "GIT_CONFIG_VALUE_0": "",
      "GIT_CONFIG_KEY_1": "credential.helper",
      "GIT_CONFIG_VALUE_1": "!f(){ echo username=jpcosec; echo \"password=$(gh auth token -u jpcosec)\"; }; f",
      "GIT_CONFIG_KEY_2": "credential.https://github.com.username",
      "GIT_CONFIG_VALUE_2": "jpcosec"
    },
    "suite": [
      "sh",
      "-c",
      "PYTHONPATH=src /mnt/ssd/proyectos/SLDB_1/.venv/bin/python -m pytest -q -n 4 -p no:cacheprovider tests"
    ],
    "suite_timeout": 5400,
    "tests_lock": "/dev/shm/sldb1-tests.lock"
  },
  "project_identity": "IR",
  "dispatch": {
    "project": "sldb-1",
    "workspace": "/mnt/ssd/proyectos/SLDB_1",
    "templates_dir": "/home/robocop/.scion/project-configs/sldb-1__b0899ed7/.scion/templates",
    "context_file": "/mnt/ssd/proyectos/SLDB_1/.bootstrap/ir-scion-context.json",
    "roles_root": "/mnt/ssd/proyectos/SLDB_1/deskops",
    "roles": {
      "executor": {
        "role": "deskops-executor",
        "harness": "claude",
        "model_alias": "medium",
        "harness_auth": "oauth-token",
        "env_config": "/mnt/ssd/proyectos/SLDB_1/.bootstrap/ir-scion-env.yaml"
      },
      "tester": {
        "role": "deskops-tester",
        "harness": "pi",
        "model_alias": "medium",
        "harness_auth": "api-key",
        "env_config": "/mnt/ssd/proyectos/SLDB_1/.bootstrap/pi-scion-env.yaml"
      }
    }
  },
  "queue_jobs": {
    "integrate": {
      "run": ["deskops", "integrate", "--task-from-env", "--root", "."],
      "timeout": 7200
    },
    "dispatch-executor": {
      "run": [
        "sh",
        "-c",
        "deskops dispatch start executor --task \"$DESKOPS_TASK_ID\" --root \"$DESKOPS_ROOT\""
      ],
      "timeout": 600,
      "retry_exit_codes": [
        3
      ]
    },
    "dispatch-tester": {
      "run": [
        "sh",
        "-c",
        "deskops dispatch start tester --task \"$DESKOPS_TASK_ID\" --root \"$DESKOPS_ROOT\""
      ],
      "timeout": 600,
      "retry_exit_codes": [
        3
      ]
    },
    "dispatch-reap": {
      "run": [
        "sh",
        "-c",
        "deskops dispatch reap --task \"$DESKOPS_TASK_ID\" --root \"$DESKOPS_ROOT\""
      ],
      "timeout": 600
    }
  },
  "queue_min_available_gb": 8,
  "queue_max_psi_avg60": 10,
  "versions": {
    "desk_format": "1.0.0",
    "model_version": "1.0.0"
  },
  "sandbox": {
    "enabled": false,
    "sandbox_root": ".tmp/deskops-sandbox"
  }
}
